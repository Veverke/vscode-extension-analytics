{
  "name": "vscode-extension-analytics",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-data.mjs",
    "build:webview": "vite build --config vite.webview.config.ts && node scripts/copy-data.mjs",
    "build:extension": "npm run build:webview && cd extension && npm run compile",
    "lint": "eslint src collect extension tests --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "vsix": "npm run build:extension && cd extension && vsce package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Veverke/vscode-extension-analytics.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Veverke/vscode-extension-analytics/issues"
  },
  "homepage": "https://github.com/Veverke/vscode-extension-analytics#readme",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/regression": "^2.0.6",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "regression": "^2.0.1"
  }
}
